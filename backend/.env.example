# Zoho OAuth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in

# Zoho module API name. Confirm this in Zoho Developer Hub > APIs and SDKs > API Names.
ZOHO_BOOKINGS_MODULE_API_NAME=Bookings

# Lead custom field API names
ZOHO_LEAD_VEHICLE_FIELD=Vehicle_Model
ZOHO_LEAD_VARIANT_FIELD=Interested_Variant
ZOHO_LEAD_CITY_FIELD=Preferred_City

# Deal custom field API names
ZOHO_DEAL_CUSTOMER_PHONE_FIELD=Customer_Phone
ZOHO_DEAL_VEHICLE_FIELD=Vehicle_Model
ZOHO_DEAL_TEST_DRIVE_DATE_FIELD=Test_Drive_Date
ZOHO_DEAL_TEST_DRIVE_TIME_FIELD=Test_Drive_Time
ZOHO_DEAL_DEALER_FIELD=Dealer_Name
ZOHO_DEAL_FOLLOW_UP_FIELD=Follow_Up_Preference

# Booking custom field API names
ZOHO_BOOKING_ID_FIELD=Booking_ID
ZOHO_BOOKING_VEHICLE_FIELD=Vehicle_Model
ZOHO_BOOKING_STATUS_FIELD=Booking_Status
ZOHO_BOOKING_ALLOCATION_STAGE_FIELD=Allocation_Stage
ZOHO_BOOKING_VIN_FIELD=VIN
ZOHO_BOOKING_DELIVERY_DATE_FIELD=Expected_Delivery_Date
ZOHO_BOOKING_PAYMENT_LINK_FIELD=Balance_Payment_Link
ZOHO_BOOKING_PHONE_FIELD=Phone

# Case custom field API names
ZOHO_CASE_REGISTRATION_FIELD=Registration_Number
ZOHO_CASE_ODOMETER_FIELD=Odometer
ZOHO_CASE_SERVICE_TYPE_FIELD=Service_Type
ZOHO_CASE_SERVICE_CENTER_FIELD=Preferred_Service_Center
ZOHO_CASE_ISSUE_FIELD=Issue_Description
ZOHO_CASE_PREFERRED_DATE_FIELD=Preferred_Date
ZOHO_CASE_CONTACT_FIELD=Contact_Name

# Optional LLM configuration. Leave GROQ_API_KEY blank until we configure AI.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# App configuration
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
